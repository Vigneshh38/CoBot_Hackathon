# Copy to .env and fill in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Free key from https://carto.com/basemaps/apikey (map falls back to OpenFreeMap if empty)
NEXT_PUBLIC_CARTO_KEY=
# AI triage via Claude Code headless CLI (needs `claude` installed and signed in)
AI_ENABLED=true
AI_MODEL=haiku
# CLAUDE_BIN=claude

# Email updates to reporters (optional). Gmail: smtp.gmail.com, port 465, your address + a 16-letter App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Link used in emails (your tunnel URL for phones)
PUBLIC_BASE_URL=http://localhost:3000

# SOS browser push alerts (Web Push). Leave empty: a key pair is generated once into data/vapid.json.
# To set your own: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Minutes before the same phone/device can send another SOS
SOS_COOLDOWN_MIN=10
# SMS to family contacts on SOS (optional, Twilio). Empty = SMS printed in the server terminal (demo mode).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional control-room number added to the offline SOS SMS (e.g. a Twilio number). Family numbers are always included.
NEXT_PUBLIC_SOS_SMS_NUMBER=
